generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String     @map("password_hash")
  name          String
  phone         String?
  role          String     @default("USER")
  avatarUrl     String?    @map("avatar_url")
  isVerified    Boolean    @default(false) @map("is_verified")
  isBlocked     Boolean    @default(false) @map("is_blocked")
  blockedAt     DateTime?  @map("blocked_at")
  blockedReason String?    @map("blocked_reason")
  
  // 基本資料
  gender        String?    // MALE, FEMALE
  referralSource String?   @map("referral_source") // 如何得知本站
  
  // 聯絡資訊
  lineUrl       String?    @map("line_url") // Line 網址
  
  // 緊急聯絡人（AGENT, AGENCY 需要）
  emergencyContactRelation String? @map("emergency_contact_relation") // 緊急聯絡人身份
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  
  // 工作相關（AGENT, AGENCY 需要）
  workArea      String?    @map("work_area") // 工作區域
  companyId     String?    @map("company_id") // 所屬公司 ID（如果是選擇的）
  companyName   String?    @map("company_name") // 所屬公司名稱（如果是輸入的）
  branchId      String?    @map("branch_id") // 分店 ID（如果是選擇的）
  branchName    String?    @map("branch_name") // 分店名稱（如果是輸入的）
  branchType    String?    @map("branch_type") // 分店型態：DIRECT (直營店), FRANCHISE (加盟店)
  position      String?    // 所屬職位
  brokerageName String?   @map("brokerage_name") // 經紀業名稱（AGENT, AGENCY 需要）
  hideCompanyInfo Boolean  @default(false) @map("hide_company_info") // 物件詳情頁、店鋪隱藏公司信息
  
  // 公司相關（AGENCY, DEVELOPER 需要）
  accountType   String?    @map("account_type") // 賬號歸屬：GROUP (集團賬號), BRANCH (分店賬號), OTHER (其他)
  companyNameFull String?  @map("company_name_full") // 公司名稱（DEVELOPER 需要）
  
  // 發票相關（LANDLORD, AGENT, AGENCY, DEVELOPER 需要）
  invoiceMethod String?   @map("invoice_method") // DONATE, CLOUD, UNIFIED, MOBILE
  unifiedNumber String?   @map("unified_number") // 統一編號
  invoiceBuyer  String?   @map("invoice_buyer") // 買受人
  invoicePhone  String?   @map("invoice_phone") // 發票聯絡電話
  invoiceCity   String?   @map("invoice_city") // 發票收件縣市
  invoiceDistrict String? @map("invoice_district") // 發票收件區域
  invoiceAddress String?  @map("invoice_address") // 發票收件完整地址
  mobileCarrier  String?  @map("mobile_carrier") // 手機載具條碼
  
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  listings      Listing[]
  favorites     Favorite[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[] @relation("TargetUser")
  adminActions  AuditLog[] @relation("AdminUser")
  orders        Order[]
  subscriptions Subscription[]

  @@map("users")
}

model Listing {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  title           String
  description     String?
  price           Int
  currency        String    @default("TWD")
  propertyType    String    @map("property_type")
  beds            Int       @default(1)
  baths           Int       @default(1)
  area            Float?
  address         String?
  city            String?
  district        String?
  latitude        Float?
  longitude       Float?
  amenities       String    @default("[]")
  status          String    @default("DRAFT")
  viewCount       Int       @default(0) @map("view_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images          ListingImage[]
  favorites       Favorite[]

  @@index([userId])
  @@index([status])
  @@index([propertyType])
  @@index([price])
  @@map("listings")
}

model ListingImage {
  id          String   @id @default(uuid())
  listingId   String   @map("listing_id")
  key         String
  url         String
  bucket      String
  filename    String
  mimeType    String   @map("mime_type")
  size        Int
  width       Int?
  height      Int?
  isCover     Boolean  @default(false) @map("is_cover")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  listingId   String   @map("listing_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("favorites")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  token       String   @unique
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String    @id @default(uuid())
  adminId       String    @map("admin_id")
  action        String
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  targetUserId  String?   @map("target_user_id")
  previousValue String?   @map("previous_value")
  newValue      String?   @map("new_value")
  reason        String?
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")

  admin         User      @relation("AdminUser", fields: [adminId], references: [id])
  targetUser    User?     @relation("TargetUser", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PhoneVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@index([phone, code])
  @@map("phone_verifications")
}

// ========== 金流相關模型 ==========

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  orderNumber     String      @unique @map("order_number") // 訂單編號，例如：ORD20240101001
  status          String      @default("PENDING") // PENDING, PAID, CANCELLED, REFUNDED, EXPIRED
  totalAmount     Int         @map("total_amount") // 總金額（分）
  currency        String      @default("TWD")
  paymentMethod   String?     @map("payment_method") // CREDIT_CARD, ATM, CVS, etc.
  paymentStatus   String      @default("UNPAID") @map("payment_status") // UNPAID, PAID, FAILED, REFUNDED
  paidAt          DateTime?   @map("paid_at")
  expiresAt       DateTime?   @map("expires_at") // 訂單過期時間
  notes           String?     // 備註
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payments        Payment[]
  subscriptions   Subscription[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productType     String   @map("product_type") // LISTING_AD, PACKAGE, ADDON
  productId       String?  @map("product_id") // 產品ID（如套餐ID）
  productName     String   @map("product_name") // 產品名稱
  productCategory String?  @map("product_category") // RESIDENTIAL, COMMERCIAL, SALE
  quantity        Int      @default(1)
  unitPrice       Int      @map("unit_price") // 單價（分）
  totalPrice      Int      @map("total_price") // 總價（分）
  duration        Int?     // 天數
  metadata        String?  @default("{}") // JSON格式的額外資訊
  createdAt       DateTime @default(now()) @map("created_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productType])
  @@map("order_items")
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  paymentNumber   String   @unique @map("payment_number") // 付款編號
  amount          Int      // 付款金額（分）
  currency        String   @default("TWD")
  paymentMethod   String   @map("payment_method") // CREDIT_CARD, ATM, CVS, etc.
  paymentProvider String   @map("payment_provider") // ECPAY, NEWEBPAY, etc.
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED, REFUNDED
  transactionId   String?  @map("transaction_id") // 第三方交易ID
  paymentUrl      String?  @map("payment_url") // 付款連結（ATM、CVS）
  bankCode        String?  @map("bank_code") // ATM 銀行代碼
  accountNumber   String?  @map("account_number") // ATM 虛擬帳號
  expireDate      DateTime? @map("expire_date") // 付款截止日
  paidAt          DateTime? @map("paid_at")
  refundedAt      DateTime? @map("refunded_at")
  refundAmount    Int?     @default(0) @map("refund_amount")
  metadata        String?  @default("{}") // JSON格式的額外資訊
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentNumber])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
  @@map("payments")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  orderId         String   @map("order_id")
  orderItemId     String   @map("order_item_id")
  productType     String   @map("product_type") // PACKAGE, LISTING_AD
  productId       String?  @map("product_id")
  productName     String   @map("product_name")
  status          String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, USED_UP
  totalQuantity   Int      @default(0) @map("total_quantity") // 總數量（如套餐筆數）
  usedQuantity    Int      @default(0) @map("used_quantity") // 已使用數量
  remainingQuantity Int    @default(0) @map("remaining_quantity") // 剩餘數量
  validFrom       DateTime @map("valid_from") // 生效日期
  validUntil      DateTime @map("valid_until") // 到期日期
  metadata        String?  @default("{}") // JSON格式的額外資訊
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([validUntil])
  @@map("subscriptions")
}

model WebhookLog {
  id            String   @id @default(uuid())
  provider      String   // MOCK, ECPAY, NEWEBPAY, LINE_PAY, STRIPE
  eventType     String   @map("event_type") // payment.success, payment.failed, etc.
  transactionId String?  @map("transaction_id")
  orderId       String?  @map("order_id")
  status        String   @default("PENDING") // SUCCESS, FAILED, PENDING
  requestBody   String   @map("request_body") // JSON string
  responseBody  String?  @map("response_body") // JSON string
  errorMessage  String?  @map("error_message")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@index([transactionId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_logs")
}
