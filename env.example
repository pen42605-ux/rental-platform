# ==================== 資料庫設定 ====================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rental_platform"
# 或使用 SQLite (開發環境)
# DATABASE_URL="file:./dev.db"

# ==================== JWT 設定 ====================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# ==================== Sentry 錯誤追蹤 ====================
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_SENTRY_DSN=""

# ==================== 日誌設定 ====================
LOG_LEVEL="info"  # error, warn, info, debug

# ==================== AWS S3 設定 ====================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET=""
S3_BACKUP_BUCKET=""  # 備份用 S3 Bucket

# ==================== 搜尋引擎設定 ====================
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# ==================== 備份設定 ====================
BACKUP_DIR="/backups/postgresql"  # Linux/Mac
# BACKUP_DIR="C:\backups\postgresql"  # Windows
RETENTION_DAYS=30

# ==================== Facebook OAuth 設定 ====================
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
NEXT_PUBLIC_FACEBOOK_APP_ID=""  # 前端使用的 Facebook App ID（與 FACEBOOK_APP_ID 相同）

# ==================== 前端設定 ====================
NEXT_PUBLIC_API_URL="http://localhost:4000"  # 後端 API URL（前端使用）
NEXT_PUBLIC_FACEBOOK_APP_ID=""  # Facebook App ID（前端使用）

# ==================== 支付設定 ====================
# 支付服務商選擇（MOCK, ECPAY, NEWEBPAY, LINE_PAY）
PAYMENT_PROVIDER="MOCK"

# 綠界（ECPay）設定
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
ECPAY_SANDBOX="true"  # 是否使用沙盒環境
ECPAY_RETURN_URL="http://localhost:4000/api/payment/callback/ecpay/return"
ECPAY_NOTIFY_URL="http://localhost:4000/api/payment/callback/ecpay/notify"

# 藍新（NewebPay）設定
NEWEBPAY_MERCHANT_ID=""
NEWEBPAY_HASH_KEY=""
NEWEBPAY_HASH_IV=""
NEWEBPAY_SANDBOX="true"  # 是否使用沙盒環境
NEWEBPAY_RETURN_URL="http://localhost:4000/api/payment/callback/newebpay/return"
NEWEBPAY_NOTIFY_URL="http://localhost:4000/api/payment/callback/newebpay/notify"

# LINE Pay 設定
LINEPAY_CHANNEL_ID=""
LINEPAY_CHANNEL_SECRET=""
LINEPAY_SANDBOX="true"  # 是否使用沙盒環境
LINEPAY_RETURN_URL="http://localhost:4000/api/payment/callback/linepay/return"
LINEPAY_CANCEL_URL="http://localhost:4000/api/payment/callback/linepay/cancel"

# 支付方式對應的服務商（可選，用於覆蓋默認選擇）
PAYMENT_PROVIDER_CREDIT_CARD="ECPAY"
PAYMENT_PROVIDER_ATM="ECPAY"
PAYMENT_PROVIDER_CVS="ECPAY"
PAYMENT_PROVIDER_WEBATM="NEWEBPAY"
PAYMENT_PROVIDER_APPLE_PAY="ECPAY"
PAYMENT_PROVIDER_GOOGLE_PAY="ECPAY"

# API 基礎 URL（用於生成回調 URL）
API_BASE_URL="http://localhost:4000"

# ==================== 其他設定 ====================
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
